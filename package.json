{
  "name": "liverykit",
  "version": "0.2.0",
  "description": "Generate Assetto Corsa liveries from code, placed by each car's measured UV layout",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./packs/core": "./src/packs/core.mjs",
    "./packs/synthwave": "./src/packs/synthwave.mjs",
    "./packs/classic": "./src/packs/classic.mjs",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./test/fixtures/kn5.mjs": "./test/fixtures/kn5.mjs"
  },
  "bin": {
    "liverykit": "bin/liverykit.mjs"
  },
  "files": [
    "bin",
    "src",
    "test/fixtures/kn5.mjs",
    "cars/abarth500.json",
    "cars/ac_friends_honda_nsx_gt3_evo.json",
    "cars/tatuusfa1.json",
    "liveries/neon-grid.mjs",
    "liveries/neon-grid-any.mjs",
    "liveries/decal-demo",
    "fits/neon-grid-any@abarth500.json",
    "docs",
    "!docs/dev",
    "!docs/images",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node bin/liverykit.mjs neon-grid",
    "uvgrid": "node bin/liverykit.mjs neon-grid --uvgrid",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:fast": "node --test test/dds.test.mjs test/integrity.test.mjs test/ui.test.mjs test/classifier.test.mjs test/mcp.test.mjs test/decals.test.mjs"
  },
  "keywords": [
    "assetto-corsa",
    "livery",
    "skin",
    "dds",
    "sim-racing",
    "generative",
    "uv-mapping",
    "content-manager"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "ac-cardata": "^0.1.1",
    "colord": "^2.10.0",
    "sharp": "^0.35.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishan/liverykit.git"
  },
  "bugs": {
    "url": "https://github.com/mishan/liverykit/issues"
  },
  "homepage": "https://github.com/mishan/liverykit#readme"
}
